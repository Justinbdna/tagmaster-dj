{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tagmaster DJ",
  "version": "0.3.0",
  "identifier": "com.justinbdna.tagmaster-dj",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Tagmaster DJ",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["liquidGlassClear", "hudWindow", "mica"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Justinbdna",
    "category": "Music",
    "shortDescription": "Tagger, nettoyer, convertir et exporter vos bibliothèques musicales locales",
    "longDescription": "Application desktop open-source local-first pour nettoyer, standardiser, tagger automatiquement (Apple Music, Deezer, MusicBrainz, Discogs, yt-dlp, LRCLIB/Genius), dédoublonner, convertir via FFmpeg et exporter vos bibliothèques musicales locales (Standard, iPod, PSP).",
    "copyright": "Copyright © 2026 Justinbdna — Licence MIT",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
