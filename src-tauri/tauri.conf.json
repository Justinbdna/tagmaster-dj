{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tagmaster DJ",
  "version": "0.2.0",
  "identifier": "com.tagmasterdj.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Tagmaster DJ",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["liquidGlassClear", "hudWindow", "mica"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
